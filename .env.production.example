# Настройки магазина на сервере. Скопируйте в .env и заполните: sudo cp .env.production.example .env
# Файл .env содержит токен бота и пароль базы — не коммитьте его и не пересылайте в чатах.

# Домен, на котором откроется магазин (A-запись должна указывать на IP сервера).
# Без своего домена на старте подойдёт адрес вида 203-0-113-10.sslip.io (цифры — IP сервера через дефис).
APP_DOMAIN=shop.example.com
PUBLIC_APP_URL=https://shop.example.com/

POSTGRES_DB=sakura_vape
POSTGRES_USER=sakura
# Случайный пароль: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_hex_password

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Telegram ID: владелец видит всё, админ ведёт каталог, менеджер получает заказы
OWNER_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_ID=123456789
MANAGER_TELEGRAM_ID=123456789
PORT=4000
