{$APP_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@html path / /index.html
	header @html {
		Cache-Control "no-store, no-cache, must-revalidate"
		Pragma "no-cache"
		Expires "0"
	}

	@static path /assets/* /sakura-logo.png
	header @static Cache-Control "public, max-age=31536000, immutable"

	@productImages path /products/*
	header @productImages Cache-Control "public, max-age=300"

	@api path /api/*
	handle @api {
		reverse_proxy api:4000
	}

	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
